<Window x:Class="DSRRandomizer.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSR Randomizer — Manual Offline Mod Runtime"
        Width="720"
        Height="700"
        MinWidth="640"
        MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Text="DSR Randomizer" />
            <TextBlock Margin="0,8,0,20"
                       TextWrapping="Wrap"
                       Text="The original game and installed Overhaul are read-only and will not be modified." />

            <Border Padding="14"
                    Margin="0,0,0,20"
                    BorderBrush="#CC8A6D00"
                    BorderThickness="1"
                    Background="#FFFFF4CE">
                <TextBlock TextWrapping="Wrap"
                           Text="Steam Offline Mode required; launcher does not block networking; modded copy only; original and Overhaul remain untouched." />
            </Border>

            <TextBlock FontWeight="SemiBold"
                       Text="External material root" />
            <TextBlock Margin="0,6,0,8"
                       TextWrapping="Wrap"
                       Text="All copied game files, mods, saves, manifests, logs, and staging data stay under this existing external root. Only this selection pointer is stored locally." />
            <TextBox Margin="0,0,0,8"
                     MinHeight="30"
                     VerticalContentAlignment="Center"
                     Text="{Binding ExternalRootPath, UpdateSourceTrigger=PropertyChanged}" />
            <WrapPanel Margin="0,0,0,16">
                <Button MinWidth="180"
                        Padding="12,7"
                        Content="Save external root"
                        Command="{Binding SaveExternalRootCommand}" />
                <TextBlock Margin="12,6,0,0"
                           TextWrapping="Wrap"
                           Text="Restart required after changing the external root." />
            </WrapPanel>

            <TextBlock FontWeight="SemiBold"
                       Text="Dark Souls Remastered installation" />
            <TextBox Margin="0,6,0,12"
                     MinHeight="30"
                     VerticalContentAlignment="Center"
                     Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}" />

            <WrapPanel Margin="0,0,0,16">
                <Button MinWidth="150"
                        Margin="0,0,8,0"
                        Padding="12,7"
                        Content="Verify installation"
                        Command="{Binding VerifyCommand}" />
                <Button MinWidth="180"
                        Padding="12,7"
                        Content="Create external runtime"
                        Command="{Binding InitializeCommand}" />
            </WrapPanel>

            <ProgressBar Height="18"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressPercent}" />

            <TextBlock Margin="0,20,0,0"
                       FontWeight="SemiBold"
                       Text="Dedicated randomizer save" />
            <TextBlock Margin="0,6,0,8"
                       TextWrapping="Wrap"
                       Text="Choose the exact SteamID. An existing external save can be reused without reading the normal save; the first copy requires explicit confirmation." />
            <ComboBox Margin="0,0,0,8"
                      MinHeight="30"
                      ItemsSource="{Binding SaveProfiles}"
                      SelectedItem="{Binding SelectedSaveProfile}"
                      IsEnabled="{Binding AreSaveControlsEnabled}"
                      DisplayMemberPath="SteamId" />
            <TextBlock Text="Source normal save" />
            <TextBlock Margin="0,3,0,8"
                       Text="{Binding SelectedSaveSourcePath}"
                       TextWrapping="Wrap" />
            <TextBlock Text="External dedicated destination" />
            <TextBlock Margin="0,3,0,8"
                       Text="{Binding DedicatedSavePath}"
                       TextWrapping="Wrap" />
            <CheckBox Margin="0,0,0,8"
                      IsChecked="{Binding FirstCopyConfirmed}"
                      IsEnabled="{Binding AreSaveControlsEnabled}"
                      Content="I confirm the first copy from the exact source shown above." />
            <Button MinWidth="180"
                    HorizontalAlignment="Left"
                    Padding="12,7"
                    Content="Discover / prepare dedicated save"
                    Command="{Binding PrepareSaveCommand}" />

            <Button Margin="0,18,0,14"
                    Padding="12,9"
                    Content="Launch modded copy"
                    Command="{Binding LaunchCommand}" />

            <TextBlock FontWeight="SemiBold"
                       Text="Status" />
            <TextBlock Margin="0,6,0,0"
                       MinHeight="48"
                       Text="{Binding Status}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
