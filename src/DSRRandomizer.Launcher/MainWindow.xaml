<Window x:Class="DSRRandomizer.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSR Randomizer — Isolation Foundation"
        Width="720"
        Height="520"
        MinWidth="640"
        MinHeight="460"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock FontSize="24"
                       FontWeight="SemiBold"
                       Text="DSR Randomizer" />
            <TextBlock Margin="0,8,0,20"
                       TextWrapping="Wrap"
                       Text="The original game and installed Overhaul are read-only and will not be modified." />

            <Border Padding="14"
                    Margin="0,0,0,20"
                    BorderBrush="#CC8A6D00"
                    BorderThickness="1"
                    Background="#FFFFF4CE">
                <TextBlock TextWrapping="Wrap"
                           Text="Safety lock: this foundation release cannot start the game because dedicated-save redirection and official-online blocking are not installed yet." />
            </Border>

            <TextBlock FontWeight="SemiBold"
                       Text="Dark Souls Remastered installation" />
            <TextBox Margin="0,6,0,12"
                     MinHeight="30"
                     VerticalContentAlignment="Center"
                     Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}" />

            <WrapPanel Margin="0,0,0,16">
                <Button MinWidth="150"
                        Margin="0,0,8,0"
                        Padding="12,7"
                        Content="Verify installation"
                        Command="{Binding VerifyCommand}" />
                <Button MinWidth="180"
                        Padding="12,7"
                        Content="Create external runtime"
                        Command="{Binding InitializeCommand}" />
            </WrapPanel>

            <ProgressBar Height="18"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding ProgressPercent}" />

            <Button Margin="0,18,0,14"
                    Padding="12,9"
                    Content="Launch Random Dark Souls (safety components required)"
                    IsEnabled="{Binding CanLaunch}" />

            <TextBlock FontWeight="SemiBold"
                       Text="Status" />
            <TextBlock Margin="0,6,0,0"
                       MinHeight="48"
                       Text="{Binding Status}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
